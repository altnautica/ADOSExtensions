{
  "name": "ados-extensions",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "typecheck": "pnpm --filter @altnautica/plugin-sdk build && pnpm -r typecheck",
    "build:thermal-camera": "pnpm --filter ./extensions/thermal-camera-flir-lepton-usb/gcs build",
    "test:thermal-camera": "pnpm --filter ./extensions/thermal-camera-flir-lepton-usb/gcs test",
    "build:mavlink-gimbal-v2": "pnpm --filter ./extensions/mavlink-gimbal-v2/gcs build",
    "test:mavlink-gimbal-v2": "pnpm --filter ./extensions/mavlink-gimbal-v2/gcs test",
    "build:follow-me": "pnpm --filter ./extensions/follow-me/gcs build",
    "test:follow-me": "pnpm --filter ./extensions/follow-me/gcs test",
    "build:siyi-pod": "pnpm --filter ./extensions/siyi-pod/gcs build",
    "test:siyi-pod": "pnpm --filter ./extensions/siyi-pod/gcs test",
    "build:vision-nav": "pnpm --filter ./extensions/vision-nav/gcs build",
    "test:vision-nav": "pnpm --filter ./extensions/vision-nav/gcs test",
    "build:world-engine": "pnpm --filter @altnautica/plugin-sdk build && pnpm --filter ./extensions/world-engine/gcs build",
    "test:world-engine": "pnpm --filter ./extensions/world-engine/gcs test"
  },
  "engines": {
    "pnpm": ">=9"
  }
}
