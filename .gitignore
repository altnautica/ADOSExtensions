node_modules/
dist/
.pnpm-store/
.venv/
__pycache__/
*.adosplug
*.tsbuildinfo
.DS_Store
extensions/*/gcs/plugin.bundle.js

# Capture and Reconstruct inline GCS build output. The Rerun wasm is copied
# from node_modules by the build and staged as a release payload, never
# committed.
extensions/capture/gcs/capture.mjs
extensions/capture/gcs/plugin.css
extensions/capture/gcs/assets/
extensions/reconstruct/gcs/reconstruct.mjs
extensions/reconstruct/gcs/plugin.css
extensions/reconstruct/gcs/assets/
extensions/reconstruct/gcs/tour-viewer/

# Reconstruct node: fetched third-party tools and python project envs.
extensions/reconstruct/agent/node/tools/cache/
extensions/reconstruct/agent/node/python/*/.venv/

# Rust build output (the cargo workspace at the repo root)
/target

# Local omp agent tooling directory (not part of the project)
.omp/

# Signing keys and local secrets. Public .pem files stay committable.
keys/*
!keys/*.pub.pem
*.priv.pem
*.ed25519
*.key
.env*
