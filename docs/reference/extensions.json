{
  "schema": 1,
  "extensions": [
    {
      "id": "com.altnautica.follow-me",
      "name": "ADOS Follow-Me",
      "version": "0.2.10",
      "description": "Lock onto an operator-designated subject and fly a fixed-distance standoff follow from the companion. A flight Skill in the cockpit Skill Bar, a click-a-target Follow action, and a per-drone settings tab.",
      "category": null,
      "supported_boards": [
        "cm4",
        "cm5",
        "rock-5c-lite",
        "rk3588s2",
        "rk3576",
        "rpi5",
        "cubie-a7s",
        "cubie-a7z"
      ],
      "permissions": [
        "event.publish",
        "flight.guided_setpoint",
        "mavlink.read",
        "mavlink.write",
        "mcp.expose",
        "ui.slot.flight-skill",
        "ui.slot.node-detail-tab",
        "vision.detection.subscribe"
      ],
      "halves": [
        "agent",
        "gcs"
      ],
      "documentation_url": "https://docs.altnautica.com/drone-agent/extensions-catalog#ados-follow-me",
      "published": true
    },
    {
